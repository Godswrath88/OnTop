<Window x:Class="OnTop.Views.AutoCloseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OnTop — Auto-Close" Width="780" Height="560"
        Style="{StaticResource DarkChromeWindow}" ShowInTaskbar="True"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="{DynamicResource FgMutedBrush}" Margin="0,0,0,10"
                   Text="When Auto-Close Is Enabled And Any Trigger Process Is Running, OnTop Exits Itself. Changes Apply Immediately — Save From The Main Window To Persist."/>

        <GroupBox Grid.Row="1" Header="Behavior" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <CheckBox Content="Enable Auto-Close" IsChecked="{Binding Cfg.AutoCloseEnabled}"
                          Style="{StaticResource ToggleSwitch}" Margin="0,4,22,4"/>
                <CheckBox Content="Check On Start Only" IsChecked="{Binding Cfg.AutoCloseOnStartOnly}"
                          Style="{StaticResource ToggleSwitch}" Margin="0,4,22,4"/>
                <TextBlock Text="Poll Interval (Seconds):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Width="56" VerticalAlignment="Center"
                         Text="{Binding Cfg.AutoCloseInterval, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </GroupBox>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Running Processes">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="FilterBox" Grid.Row="0" Margin="0,0,0,6"
                             TextChanged="Filter_Changed" ToolTip="Filter Processes"/>
                    <ListBox x:Name="ProcList" Grid.Row="1" SelectionMode="Extended"
                             MouseDoubleClick="ProcList_DoubleClick"/>
                </Grid>
            </GroupBox>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                <Button Style="{StaticResource TransferButton}" Margin="0,0,0,8" Click="Add_Click"
                        ToolTip="Add Selected Processes As Triggers">
                    <Path Data="M3,3 L9,9 L3,15 M9,3 L15,9 L9,15" Stroke="{DynamicResource FgPrimaryBrush}"
                          StrokeThickness="2" StrokeLineJoin="Round"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
                <Button Style="{StaticResource TransferButton}" Click="Remove_Click"
                        ToolTip="Remove Selected Triggers">
                    <Path Data="M15,3 L9,9 L15,15 M9,3 L3,9 L9,15" Stroke="{DynamicResource FgPrimaryBrush}"
                          StrokeThickness="2" StrokeLineJoin="Round"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
            </StackPanel>

            <GroupBox Grid.Column="2" Header="Trigger Processes">
                <ListBox x:Name="TrigList" ItemsSource="{Binding AutoCloseTriggers}" SelectionMode="Extended"/>
            </GroupBox>
        </Grid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="Refresh Processes" Click="Refresh_Click" Margin="0,0,6,0"/>
                <Button Content="Import..." Click="Import_Click" Margin="0,0,6,0"/>
                <Button Content="Export..." Click="Export_Click"/>
            </StackPanel>
            <Button Content="Close" Style="{StaticResource AccentButton}" Width="120" Height="32"
                    HorizontalAlignment="Right" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>

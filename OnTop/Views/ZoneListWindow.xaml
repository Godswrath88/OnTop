<Window x:Class="OnTop.Views.ZoneListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:OnTop.Helpers"
        Title="OnTop — Zones" Width="820" Height="420"
        MinWidth="560" MinHeight="240"
        Style="{StaticResource DarkChromeWindow}" ShowInTaskbar="True"
        Topmost="{Binding Cfg.GuiAlwaysOnTop}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <helpers:ZoneColorConverter x:Key="ZoneColorConverter"/>
        <helpers:WidthLabelConverter x:Key="WidthLabel"/>
    </Window.Resources>

    <Grid Margin="12">
        <DataGrid x:Name="ZonesGrid" ItemsSource="{Binding Zones}" SelectedItem="{Binding SelectedZone}" CanUserDeleteRows="False"
                  AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
                  SelectionChanged="ZonesGrid_SelectionChanged"
                  CellEditEnding="ZonesGrid_CellEditEnding">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="24" IsReadOnly="True" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="Transparent" Cursor="Hand"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    MouseLeftButtonUp="LocateCell_Click">
                                <TextBlock FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#x26A0;"/>
                                            <Setter Property="Foreground" Value="{DynamicResource WarnAmberBrush}"/>
                                            <Setter Property="ToolTip" Value="{Binding HealthWarning}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HealthWarning}" Value="">
                                                    <Setter Property="Text" Value="&#x25CE;"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource FgDimBrush}"/>
                                                    <Setter Property="ToolTip" Value="Locate On Map (Click)"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="30" IsReadOnly="True" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Width="14" Height="14" CornerRadius="3" Cursor="Hand"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    ToolTip="Click To Cycle Color"
                                    MouseLeftButtonUp="Swatch_Click"
                                    Background="{Binding ColorIndex, Converter={StaticResource ZoneColorConverter}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="X" Binding="{Binding X}" Width="60"/>
                <DataGridTextColumn Header="Y" Binding="{Binding Y}" Width="60"/>
                <DataGridTextColumn Binding="{Binding MonitorLabel}" Width="66" IsReadOnly="True">
                    <DataGridTextColumn.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}, Converter={StaticResource WidthLabel}, ConverterParameter='56|Mon|Monitor'}"/>
                        </DataTemplate>
                    </DataGridTextColumn.HeaderTemplate>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Tol" Binding="{Binding Tolerance}" Width="50"/>
                <DataGridTextColumn Header="CapX" Binding="{Binding CapX}" Width="55"/>
                <DataGridTextColumn Header="CapY" Binding="{Binding CapY}" Width="55"/>
                <DataGridTextColumn Header="Var" Binding="{Binding Variation}" Width="50"/>
                <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="52" IsReadOnly="True"/>
                <DataGridCheckBoxColumn Header="Overlay" Binding="{Binding ShowDot, UpdateSourceTrigger=PropertyChanged}" Width="64"/>
                <DataGridTemplateColumn Header="Action" Width="66" IsReadOnly="True" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Padding="6,1" Margin="2"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    MouseLeftButtonUp="ZoneAction_Click">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource RowDangerTintBrush}"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="ToolTip" Value="Click To Flip: Exit Closes OnTop, Stealth Unhooks The Mouse Instead"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TriggerAction}" Value="Stealth">
                                                <Setter Property="Background" Value="{DynamicResource RowAccentTintBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DataContext.Cfg.ZonesTriggerStealth, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True">
                                                <Setter Property="Opacity" Value="0.4"/>
                                                <Setter Property="IsHitTestVisible" Value="False"/>
                                                <Setter Property="Cursor" Value="Arrow"/>
                                                <Setter Property="ToolTip" Value="Overridden By 'Zones Trigger Stealth' — Every Zone Uses Stealth Right Now"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding TriggerAction}" FontSize="11"
                                           Foreground="{DynamicResource FgPrimaryBrush}"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="No Zones Yet — Click Record Or Double-Click The Map"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource FgDimBrush}" IsHitTestVisible="False">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Zones.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</Window>

<Window x:Class="OnTop.Views.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:OnTop.Helpers"
        Title="OnTop — Log Viewer" Width="860" Height="540"
        MinWidth="600" MinHeight="340"
        Style="{StaticResource DarkChromeWindow}" ShowInTaskbar="True"
        Topmost="{Binding Cfg.GuiAlwaysOnTop}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <helpers:LogLevelBrushConverter x:Key="LevelBrush"/>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBlock Text="Level:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="LevelBox" Width="96" SelectionChanged="Filter_Changed"
                          ToolTip="Show Only Entries Of This Level">
                    <ComboBoxItem Content="All" IsSelected="True"/>
                    <ComboBoxItem Content="Debug"/>
                    <ComboBoxItem Content="Info"/>
                    <ComboBoxItem Content="Action"/>
                    <ComboBoxItem Content="Warn"/>
                    <ComboBoxItem Content="Error"/>
                </ComboBox>
                <TextBlock Text="Search:" VerticalAlignment="Center" Margin="14,0,6,0"/>
                <TextBox x:Name="SearchBox" Width="180" TextChanged="Filter_Changed"
                         ToolTip="Filter Entries By Message Or Category Text"/>
                <CheckBox x:Name="FollowBox" Content="Follow" IsChecked="True" Checked="Follow_Checked"
                          ToolTip="Auto-Scroll To The Newest Entry As It Arrives"
                          Style="{StaticResource ToggleSwitch}" Margin="14,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <CheckBox Content="Verbose (Debug)" IsChecked="{Binding Cfg.VerboseLogging}"
                          ToolTip="Also Record DEBUG-Level Detail (Persisted Setting)"
                          Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Content="Clear" Click="Clear_Click" Margin="0,0,6,0" ToolTip="Clear The On-Screen Entries (Log Files Are Untouched)"/>
                <Button Content="Open Folder" Click="OpenFolder_Click" Margin="0,0,6,0" ToolTip="Open The Folder Containing The Log Files"/>
                <Button Content="Export Diagnostics..." Click="ExportDiagnostics_Click"
                        ToolTip="Save A Zip With Settings, Stats, The Current Log, And System Info — Everything Needed For A Bug Report"/>
            </StackPanel>
        </DockPanel>

        <!-- Category tracking. DockPanel (not WrapPanel-in-WrapPanel): a nested
             WrapPanel gets unbounded width from its wrapping parent and never
             wraps itself — that's what clipped off the window edge. Docked, the
             inner panel is width-constrained and wraps properly. -->
        <DockPanel Grid.Row="1" Margin="0,0,0,4" LastChildFill="True">
            <TextBlock Text="Track:" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,4,10,0"
                       Foreground="{DynamicResource FgMutedBrush}"/>
            <WrapPanel x:Name="CategoryPanel"/>
        </DockPanel>

        <!-- Live entries -->
        <Border Grid.Row="2" Background="{DynamicResource BgMediumBrush}"
                BorderBrush="{DynamicResource BorderDimBrush}" BorderThickness="1" CornerRadius="6">
            <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.ScrollUnit="Pixel" SelectionMode="Extended"
                     KeyDown="LogList_KeyDown" ToolTip="Select Entries, Then Ctrl+C Or Right-Click To Copy">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy Selected" Click="CopySelected_Click"/>
                        <MenuItem Header="Copy All (Filtered)" Click="CopyAll_Click"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="58"/>
                                <ColumnDefinition Width="76"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Time, StringFormat=HH:mm:ss.fff}"
                                       FontFamily="Consolas" FontSize="11"
                                       Foreground="{DynamicResource FgDimBrush}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Border Grid.Column="1" CornerRadius="3" Padding="0,1"
                                    Background="{Binding Level, Converter={StaticResource LevelBrush}}"
                                    VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="{Binding Level}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="White" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="2" Text="{Binding Category}" FontSize="11"
                                       Foreground="{DynamicResource FgMutedBrush}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="3" Text="{Binding Message}" FontSize="12"
                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</Window>

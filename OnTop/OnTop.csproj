<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- App icon is optional: only embed it if one has been supplied.
         The tray code already falls back to SystemIcons.Application. -->
    <ApplicationIcon Condition="Exists('Assets\thumbtack.ico')">Assets\thumbtack.ico</ApplicationIcon>
    <RootNamespace>OnTop</RootNamespace>
    <AssemblyName>OnTop</AssemblyName>
    <!-- SECURITY: pin least-privilege (asInvoker) + DPI awareness. See SECURITY.md. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Version / AssemblyVersion / FileVersion come from ..\Directory.Build.props
         (the single version source). Surfaced at runtime in the Help window and
         the main-window subtitle. -->
    <!-- Assembly metadata (shows in the exe's Details tab). Copyright holder is
         the public handle only — never a real name, e-mail or machine name. -->
    <Authors>Godswrath88</Authors>
    <Company>Godswrath88</Company>
    <Product>OnTop</Product>
    <Copyright>Copyright (C) 2026 Godswrath88 - GPL-3.0-or-later</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <!-- Release builds must not embed the local build path (it contains the
         Windows user name and would show up in crash stack traces). Debug
         builds keep real paths so the debugger can find sources. -->
    <PathMap Condition="'$(Configuration)' == 'Release'">$(MSBuildProjectDirectory)=/_/OnTop</PathMap>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- S28: Windows DPAPI (ProtectedData) for OPTIONAL at-rest encryption of
         macro recordings. Microsoft-published; not in the shared framework on
         .NET 8, hence the package. NuGet restore must succeed (see BUILD notes). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Unit tests reach internal helpers (e.g. SettingsService.Migrate). -->
    <InternalsVisibleTo Include="OnTop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\thumbtack.ico" Condition="Exists('Assets\thumbtack.ico')" />
    <!-- The tray loads the icon from disk at runtime — ship it beside the exe. -->
    <None Include="Assets\thumbtack.ico" Condition="Exists('Assets\thumbtack.ico')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- v9.5 parity: kill a running OnTop before build so the exe isn't file-locked.
       Visual Studio builds only: a command-line, CI or test build must never
       force-close the copy I'm actually using (it did, until 0.45.4). -->
  <Target Name="KillRunningOnTop" BeforeTargets="BeforeBuild" Condition="'$(OS)' == 'Windows_NT' And '$(BuildingInsideVisualStudio)' == 'true'">
    <Exec Command="taskkill /f /im OnTop.exe &gt;nul 2&gt;&amp;1 &amp; exit /b 0" ContinueOnError="true" />
  </Target>

</Project>
